{
  "manifest_version": 3,
  "name": "Page Linker",
  "version": "1.0.0",
  "description": "Link web pages together across any site. Create groups to quickly navigate between related pages — like Gmail labels, but for the entire web.",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "tabs",
    "favicon"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+L"
      },
      "description": "Open Page Linker popup"
    }
  }
}
